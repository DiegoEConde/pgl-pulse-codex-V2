{
  "schema": "pgl_pulse_v2",
  "version": "0.1.0",
  "status": "contrato inicial para implementacion local",
  "updatedAt": "2026-09-29",
  "typeDialect": "logical-local-json",
  "sourceDocuments": [
    "docs/DECISION-V2.md",
    "docs/MODELO-NEGOCIO.md",
    "docs/REGLAS-NEGOCIO.md",
    "docs/FLUJOS-OPERATIVOS.md",
    "docs/ESTADOS-Y-CASOS-BORDE.md",
    "docs/ESTADOS.md",
    "docs/BASE-DATOS.md"
  ],
  "principles": [
    "La venta es la entidad comercial principal.",
    "Clientes y proveedores viven en tablas separadas.",
    "Vendedor y repartidor son usuarios con rol y datos operativos.",
    "Cada producto vendido o comprado se maneja como item individual.",
    "La unidad guarda IMEI, ubicacion fisica, estado y garantia como estado.",
    "El comprobante de cliente vive en la venta como numero y snapshot.",
    "Caja, cobros, pagos, rendiciones, diferencias y cierres salen de movimientos_dinero.",
    "Retiros de proveedor y entregas a cliente se concentran en rutas y ruta_items.",
    "Los cambios sensibles van a historial_eventos.",
    "No se cargan datos reales ni datos beta hasta que los flujos funcionen localmente."
  ],
  "localPersistence": {
    "mode": "local-json",
    "runtimeDataFile": "data/pgl-pulse-v2.local.json",
    "templateFile": "data/pgl-pulse-v2.local.example.json",
    "remoteProviders": "none",
    "notes": [
      "Por decision actual no se usa Supabase.",
      "La base operativa inicial sera local y basada en archivos JSON.",
      "El archivo local real no debe versionarse si contiene datos comerciales.",
      "Este contrato queda preparado para migrar mas adelante solo si el usuario lo aprueba."
    ]
  },
  "commonTypes": {
    "id": {
      "databaseType": "uuid",
      "default": "gen_random_uuid()"
    },
    "amount": {
      "databaseType": "numeric(14,2)"
    },
    "percentage": {
