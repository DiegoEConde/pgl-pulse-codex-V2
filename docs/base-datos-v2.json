        "telefono": {
          "type": "text",
          "nullable": true
        },
        "rol": {
          "type": "text",
          "nullable": false,
          "check": "rol in enum.rol_usuario"
        },
        "activo": {
          "type": "boolean",
          "nullable": false,
          "default": true
        },
        "porcentaje_comision": {
          "type": "numeric(5,2)",
          "nullable": false,
          "default": 0,
          "check": "porcentaje_comision >= 0"
        },
        "costo_envio_usd": {
          "type": "numeric(14,2)",
          "nullable": false,
          "default": 0,
          "check": "costo_envio_usd >= 0"
        },
        "costo_envio_ars": {
          "type": "numeric(14,2)",
          "nullable": false,
          "default": 0,
          "check": "costo_envio_ars >= 0"
        },
        "creado_en": {
          "type": "timestamptz",
          "nullable": false,
          "default": "now()"
        },
        "actualizado_en": {
          "type": "timestamptz",
          "nullable": false,
          "default": "now()"
        }
      },
